# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.

# ---- The mind: Claude ----
# Get a key at https://console.anthropic.com (pay per use; there's no free tier).
ANTHROPIC_API_KEY=
# How hard VIPLAV thinks before speaking: low | medium | high | xhigh | max.
# Higher is smarter on hard questions, but there's a longer pause before it talks.
VIPLAV_EFFORT=medium
# Let VIPLAV search and read the web.
VIPLAV_WEB_SEARCH=true

# ---- You ----
VIPLAV_USER_NAME=
# Languages you think and speak in, in order of preference: en, hi, te, lmn (Lambadi).
VIPLAV_LANGUAGES=en,hi,te,lmn
# Which script to write Lambadi in: Devanagari or Telugu.
VIPLAV_LAMBADI_SCRIPT=Devanagari

# ---- The voice (text to speech), all free ----
# browser       built into the browser, zero setup (default)
# kokoro        natural English + Hindi, runs on a laptop CPU   (pip install ".[kokoro]")
# mms           English + Hindi + Telugu, tiny, plainer voice   (pip install ".[mms]")
# indic-parler  best Indic quality, needs a GPU or Apple Silicon (pip install ".[indic-parler]")
# List several: each language uses the first engine that speaks it.
VIPLAV_TTS=browser
# Recommended once you can run models locally:
# VIPLAV_TTS=kokoro,mms

# ---- The ears (speech to text), all free ----
# browser   the browser's recognizer, zero setup (default); pick your language in the app
# whisper   Whisper on your own machine; detects the language itself   (pip install ".[whisper]")
VIPLAV_STT=browser
# large-v3-turbo handles Telugu and Hindi well. small is faster, but writes Telugu in the wrong script.
VIPLAV_WHISPER_MODEL=large-v3-turbo

# ---- Server ----
# Set this before you open VIPLAV to other devices, then visit http://host:port/?token=<value>
VIPLAV_ACCESS_TOKEN=
VIPLAV_HOST=127.0.0.1
VIPLAV_PORT=8765
